# Application Configuration
APP_NAME=SEO-AI-MLOps
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (Default: SQLite, can be swapped for PostgreSQL)
DATABASE_URL=sqlite:///./data/seo_platform.db

# LLM Providers (Optional for live LLM queries; fallback rule-engine works offline)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# External Google APIs (Optional)
GOOGLE_PAGESPEED_API_KEY=

# ML Model Paths
MODEL_DIR=./models/saved
